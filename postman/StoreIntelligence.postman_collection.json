        },
        {
          "name": "GET /stores/{id}/metrics — Today's metrics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/stores/{{store_id}}/metrics", "host": ["{{base_url}}"], "path": ["stores","{{store_id}}","metrics"] }
          }
        },
        {
          "name": "GET /stores/{id}/metrics — Custom time window",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/stores/{{store_id}}/metrics?start=2026-04-10T09:00:00&end=2026-04-10T18:00:00",
              "host": ["{{base_url}}"], "path": ["stores","{{store_id}}","metrics"],
              "query": [{"key":"start","value":"2026-04-10T09:00:00"},{"key":"end","value":"2026-04-10T18:00:00"}]
            }
          }
        },
